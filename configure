#!/bin/sh
# set -u
function error () { printf >&2 "%s\n\nPlease see README.md for build instructions.\n" "$1"; exit 1; }

# ===============================
# = Check required dependencies =
# ===============================

for dep in capnp ninja ragel multimarkdown; do
	which -s "$dep" || error "*** dependency missing: ‘${dep}’. Install with: brew install ${dep}"
done

for dep in pgrep pkill; do
	which -s "$dep" || error "*** dependency missing: ‘${dep}’."
done

# Homebrew prefix: ask brew, fall back to the Apple Silicon default.
prefix=""
if which -s brew; then
	prefix="$(brew --prefix 2>/dev/null)"
fi
if [[ -z "$prefix" ]]; then
	prefix="/opt/homebrew"
fi

if [[ -e local.rave ]]; then
	echo >&2 "Skipping writing ‘local.rave’: File already exists"
else
	# Checks run before the first write, so a failed run leaves no partial local.rave.
	for hdr in boost/crc.hpp boost/variant.hpp; do
		test -f "${prefix}/include/${hdr}" || error "*** dependency missing: ‘${prefix}/include/${hdr}’. Install with: brew install boost"
	done

	for hdr in capnp/message.h capnp/serialize-packed.h; do
		test -f "${prefix}/include/${hdr}" || error "*** dependency missing: ‘${prefix}/include/${hdr}’. Install with: brew install capnp"
	done

	test -f "${prefix}/include/sparsehash/dense_hash_map" || error "*** dependency missing: ‘${prefix}/include/sparsehash/dense_hash_map’. Install with: brew install google-sparsehash"

	# Exact .dylib files only: a glob matches several files on Homebrew and breaks test -f.
	for lib in capnp kj; do
		test -f "${prefix}/lib/lib${lib}.dylib" || error "*** dependency missing: ‘${prefix}/lib/lib${lib}.dylib’. Install with: brew install capnp"
	done

	echo >> local.rave "add FLAGS    \"-I${prefix}/include\""
	echo >> local.rave "add LN_FLAGS \"-L${prefix}/lib\""
fi

# ========================
# = Generate build files =
# ========================

if [[ -d "$builddir" ]];
	then bin/rave -crelease -tTextMate -b"$builddir"
	else bin/rave -crelease -tTextMate
fi
